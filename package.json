{
  "name": "@grazulex/keymark",
  "version": "0.1.0",
  "description": "Secrets broker for AI coding agents. Your model uses API keys, SSH keys and licenses without ever seeing them.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "keymark": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && node scripts/fix-imports.mjs",
    "start": "node dist/cli.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "install:global": "npm run build && npm link"
  },
  "keywords": [
    "cli",
    "secrets",
    "security",
    "claude",
    "claude-code",
    "ai",
    "agents",
    "age",
    "ssh",
    "developer-tools"
  ],
  "author": "Jean-Marc Strauven",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grazulex/keymark.git"
  },
  "bugs": {
    "url": "https://github.com/Grazulex/keymark/issues"
  },
  "homepage": "https://keymark.tech/",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "dependencies": {
    "age-encryption": "0.3.1",
    "chalk": "5.6.2",
    "commander": "12.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.19.11",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
